<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau : requêtes API Open Food Facts (nutrition). Tout le reste est local. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Activité physique : podomètre -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Localisation GPS (demandées au runtime, en contexte) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Caméra : scan code-barres (ZXing) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Notification du service de suivi (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Service de premier plan pour le suivi GPS (Android 14+ : type location) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Matériel optionnel : l'app reste installable sans -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />

    <application
        android:name=".PoidsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Poids"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Poids">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.ActivityTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
